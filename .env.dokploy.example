# Variáveis para o Dokploy (aba Environment do Compose).
# Copie para o painel — não commite segredos reais.
#
# Postgres do ERP = serviço Dokploy "espacoloungedb-etzdoz" (não o compose).
# A API monta: postgresql://espacolounge:POSTGRES_PASSWORD@espacoloungedb-etzdoz:5432/espacolounge

# --- Postgres Dokploy (Internal Host: espacoloungedb-etzdoz) ---
POSTGRES_PASSWORD=troque-esta-senha-postgres
DB_HOST=espacoloungedb-etzdoz
DB_USER=espacolounge
DB_NAME=espacolounge

# --- API ---
JWT_SECRET=troque-este-jwt-longo-e-aleatorio
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha-admin
ADMIN_NOME=Administrador
ADMIN_PROFISSIONAL_NOME=
ADMIN_PIN=
CORS_ORIGINS=["https://app.seudominio.com.br"]
RUN_MIGRATIONS=true

# --- Evolution API (WhatsApp) ---
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=troque-esta-senha-evolution
EVOLUTION_API_KEY=troque-esta-chave-evolution
EVOLUTION_SERVER_URL=https://evolution.seudominio.com.br
EVOLUTION_SESSION_CLIENT=Espaco Lounge
