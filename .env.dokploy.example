# Variáveis para o Dokploy (aba Environment do Compose).
# Copie os valores para o painel — não commite segredos reais.

# --- Postgres do ERP (serviço `db`) ---
POSTGRES_PASSWORD=troque-esta-senha-postgres
# Host DNS interno (default: db). Se aparecer ENOTFOUND db, no Dokploy → Docker
# copie o nome real do container Postgres e defina aqui, ex.:
# DB_HOST=espaco-lounge-db-xxxxx
DB_HOST=db
# Opcional: só se a BD for externa. Se vazio, a API monta
# postgresql://postgres:POSTGRES_PASSWORD@DB_HOST:5432/espaco_lounge
# DATABASE_URL=

# --- API ---
JWT_SECRET=troque-este-jwt-longo-e-aleatorio
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha-admin
ADMIN_NOME=Administrador
ADMIN_PROFISSIONAL_NOME=
ADMIN_PIN=
# Origens CORS do front (JSON array). Ajuste ao domínio real do serviço `web`.
CORS_ORIGINS=["https://app.seudominio.com.br"]
RUN_MIGRATIONS=true

# --- Evolution API (WhatsApp) ---
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=troque-esta-senha-evolution
EVOLUTION_API_KEY=troque-esta-chave-evolution
# URL pública da Evolution (domínio configurado no Dokploy para evolution-api)
EVOLUTION_SERVER_URL=https://evolution.seudominio.com.br
EVOLUTION_SESSION_CLIENT=Espaco Lounge

# Referência para Configurações → WhatsApp no ERP (após deploy):
#   URL da Evolution API  → mesma de EVOLUTION_SERVER_URL
#   API Key               → EVOLUTION_API_KEY
#   Instância             → nome criado na Evolution (ex. Espaço Lounge)
