DATABASE_URL=postgresql://postgres:postgres@localhost:5432/espaco_lounge
PORT=3000
XLSX_PATH=../resources/ERP Espaço Lounge.xlsx
# Origens permitidas (JSON array ou * em dev)
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://[::1]:4200"]
# PIN partilhado para GET/POST /api/folha* (comissões / folha). O Angular envia header X-Admin-Pin.
ADMIN_PIN=
# JWT para login do app (obrigatório em produção)
JWT_SECRET=altere-este-segredo-em-producao
# Bootstrap do primeiro admin (só cria se a tabela usuarios estiver vazia)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador
# Nome do profissional ligado ao admin (badge «Admin» na lista e vínculo no login)
ADMIN_PROFISSIONAL_NOME=Luciana
